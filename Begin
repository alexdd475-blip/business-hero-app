<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Business Hero</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f0f0f;
      color: white;
      margin: 0;
      padding: 20px;
      text-align: center;
    }
    .card {
      background: #1c1c1e;
      border-radius: 16px;
      padding: 24px;
      margin-top: 40px;
    }
    h1 {
      font-size: 24px;
      margin-bottom: 10px;
    }
    p {
      color: #aaa;
      font-size: 16px;
    }
    button {
      background: #2aabee;
      color: white;
      border: none;
      padding: 14px 28px;
      border-radius: 12px;
      font-size: 16px;
      margin-top: 20px;
      cursor: pointer;
      width: 100%;
      max-width: 280px;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Business Hero</h1>
    <p>Добро пожаловать!</p>
    <p id="user-name">Загрузка...</p>
    <button onclick="alert('Пока это просто тест. Скоро добавим персонажа!')">
      Начать
    </button>
  </div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.ready();
    tg.expand();

    // Показываем имя пользователя из Telegram
    const user = tg.initDataUnsafe?.user;
    if (user) {
      document.getElementById('user-name').innerText = 
        `Привет, ${user.first_name}!`;
    } else {
      document.getElementById('user-name').innerText = 'Привет!';
    }
  </script>
</body>
</html>
